# ── GitHub OAuth App ────────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Callback URL: {NEXT_PUBLIC_APP_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Supabase ─────────────────────────────────────────────────────────────────────
# Create project at: https://supabase.com → Settings → API
# Run supabase/schema.sql in the SQL Editor after creating the project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic ────────────────────────────────────────────────────────────────────
# Get key at: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ── App ──────────────────────────────────────────────────────────────────────────
# Local dev: http://localhost:3000 — update when deploying
NEXT_PUBLIC_APP_URL=http://localhost:3000
